// Prisma schema for the NSBE points tracker.
// Postgres is the system of record; Excel is generated on demand (see lib/export/).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EBOARD
  GENERAL
  GUEST
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  CANCELED
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  NUMBER
  YES_NO
  RATING
  DATE
}

enum RegistrationSource {
  FORM
  MANUAL
}

enum Classification {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
  GRADUATE
}

enum FileKind {
  RESUME
  HOUSE_PROOF
}

enum Audience {
  ALL
  EBOARD_ONLY
}

enum GroupKind {
  NSBE_WEEK
}

enum AwardKind {
  GAME_COMPETITION
  MONTHLY_CHAMPION
  MANUAL
  // A signed correction to a member's total — the ONLY kind whose points may
  // be negative (PointAward_points_sign_check). Never a Registration edit: see
  // lib/repo.ts createPointAdjustment.
  ADJUSTMENT
}

enum ShirtSize {
  S
  M
  L
  XL
}

// A narrow, revocable capability grant to one member — the escape valve for
// "this GENERAL member needs access to exactly one EBOARD-gated surface"
// without promoting their role (see lib/permissions.ts requireVerificationsWrite,
// the only consumer today). Checked live on every request, never cached in
// the JWT — same reasoning as lib/session.ts requireAdmin's own live role
// re-read — so a revoke takes effect on the very next request.
enum Permission {
  VERIFICATIONS_WRITE
  // Held outright only by ADMIN (see lib/access.ts PERMISSION_ROLES) — an
  // E-Board officer reads attendance but needs this granted explicitly to
  // add, remove, or re-point a registration, because all three award points.
  ATTENDANCE_WRITE
  // Held outright only by ADMIN. Deliberately NOT folded into ATTENDANCE_WRITE:
  // fixing an attendance typo and moving someone up or down the leaderboard by
  // fiat are different trusts (see lib/access.ts PERMISSION_ROLES).
  POINTS_WRITE
  // Held outright only by ADMIN, and the one grant that is genuinely useful to
  // hand to an E-Board officer: a recruiting/PCI chair needs the resume bundle
  // (/admin/resumes) and nothing else on it. NOT folded into
  // VERIFICATIONS_WRITE, which every officer holds by role -- that would give
  // the whole E-Board the ability to walk off with every member's resume.
  FILES_READ
  // Held outright only by ADMIN. The write half of /admin/houses — competition
  // winners, MANUAL House awards, revokes, and every recalculation. Reading
  // the tab is E-Board level (see lib/access.ts ADMIN_SURFACES). Its own
  // domain so a House chair can run House scoring without POINTS_WRITE, which
  // moves individual members.
  HOUSES_WRITE
}

// The four NSBE Houses as a scoring identity. User.house stays a free String
// holding the House's display NAME (see lib/houses.ts — Config.HOUSES_LIST
// lets a chapter rename one); lib/house-scoring.ts houseFromUserValue maps it
// onto this enum, and a value that maps to none of the four is "no House".
enum House {
  JOHNSON
  JEMISON
  LATIMER
  DEAN
}

// The THIRD scoring track — see HousePointAward. Nothing here is read by the
// member or E-Board tracks.
enum HouseCategory {
  SHOW_UP
  REP_YOUR_HOUSE
  WIN
  OWN_THE_MONTH
  MANUAL
}

// A chapter. One row for launch ("howard-nsbe"); everything org-scoped below
// carries an orgId so a second chapter can onboard without a data migration.
model Org {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  shortName    String
  logoUrl      String?
  primaryColor String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  users            User[]
  events           Event[]
  eventCategories  EventCategory[]
  eventGroups      EventGroup[]
  pointAwards      PointAward[]
  configs          Config[]
  adminLogs        AdminLog[]
  uploadedFiles    UploadedFile[]
  joinCodes        JoinCode[]
  permissionGrants PermissionGrant[]
  requestClaims    RequestClaim[]
  housePointAwards HousePointAward[]
}

// The sole signup security boundary (see lib/joincodes.ts): role is whatever
// the MATCHED code grants, never whatever the signup UI's picker said. code is
// bcrypt-hashed, never stored or re-displayed in plaintext after creation.
model JoinCode {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id])
  code        String
  codeHint    String
  grantsRole  Role
  label       String
  active      Boolean   @default(true)
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  createdById String?
  createdBy   User?     @relation("JoinCodeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  rotatedAt   DateTime?

  @@index([orgId, active])
}

// A User holds AT MOST ONE credential, enforced by the CHECK constraint
// User_single_credential_check (see migration 20260914200000_setup_code_column):
//   - passwordHash set, setupCode null — a real password (self-service signup,
//     or after /set-password);
//   - passwordHash null, setupCode set — pending: admin-created or reset, the
//     member signs in with the setup code (mustChangePassword = true);
//   - both null — a GUEST row from registerGuest(), which can never sign in.
// Accounts left pending by the old scheme still carry a bcrypt hash of their
// code in passwordHash with setupCode null; lib/credentials.ts accepts those.
model User {
  id                  String          @id @default(cuid())
  orgId               String
  org                 Org             @relation(fields: [orgId], references: [id])
  email               String
  passwordHash        String?
  /// Sealed (AES-256-GCM under CODE_SECRET), never plaintext — see lib/setup-code.ts.
  setupCode           String?
  setupCodeIssuedAt   DateTime?
  /// The admin who issued the current code. Keys resetPassword's double-submit window.
  setupCodeIssuedById String?
  firstName           String
  lastName            String
  studentId           String?
  classification      Classification?
  major               String?
  majorOther          String?
  membership          String?
  house               String?
  phone               String?
  personalEmail       String?
  tshirtSize          ShirtSize?
  role                Role            @default(GENERAL)
  status              UserStatus      @default(PENDING)
  mustChangePassword  Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Self-reported at check-in; only an admin's *VerifiedAt makes it count
  // toward standings (see lib/points.ts isEligible). Never zeroed out by
  // rejection — see repo.rejectDues/rejectNational.
  duesPaidReported Boolean?
  duesReportedAt   DateTime?
  duesVerifiedAt   DateTime?
  duesVerifiedById String?
  duesRevokedAt    DateTime?
  duesRevokedById  String?
  duesRevokedNote  String?

  nationalMemberReported Boolean?
  nsbeMembershipId       String?
  nationalVerifiedAt     DateTime?
  nationalVerifiedById   String?
  nationalRevokedAt      DateTime?
  nationalRevokedById    String?
  nationalRevokedNote    String?

  // Per-user season stamp — set only when duesPaidReported or
  // nationalMemberReported transitions to true (see lib/points.ts
  // isEligible / lib/repo.ts setDuesReported/setNationalReported). Bumping
  // Config.SEASON makes every stored value here stop matching at once, which
  // is the entire season-rollover mechanism: no script, no bulk update.
  membershipSeason String?

  // Set whenever classification or major is written (signup, check-in,
  // /account) — see lib/core-form.ts getMissingFields. The same no-script
  // rollover mechanism as membershipSeason: a Config.SEASON bump makes every
  // stored value here stop matching at once, re-arming the classification/
  // major question at each member's next check-in without touching this row.
  profileSeason String?

  // Verified is persistent by design — see lib/core-form.ts: once
  // houseVerifiedAt is set, the check-in form never re-asks.
  houseVerifiedAt   DateTime?
  houseVerifiedById String?
  houseProofFileId  String?

  resumeFileId    String?
  resumeUpdatedAt DateTime?
  resumeConsentAt DateTime?

  // The signup latch — null means this account is still mid-signup and every
  // protected route sends it to /join/resume (see lib/signup.ts, which derives
  // WHERE to resume from the profile data; no step index is stored anywhere).
  //
  // A latch rather than a computed predicate because two of the wizard's steps
  // are completed by declining them: "I haven't taken the test yet" on House
  // writes nothing at all by design (see clearHouseAssignment and
  // docs/CLAIM-STATE.md), and the resume upload is skippable. Without this
  // column those members would be asked the same question forever.
  //
  // Backfilled for accounts that predate it — see the migration.
  signupCompletedAt DateTime?

  /**
   * Displayed on the internal E-Board leaderboard only — see lib/repo.ts getEboardBoardRows.
   */
  eboardPosition String?

  // The trash bin (see lib/repo.ts trashMember / purgeTrashedMember). A row
  // with deletedAt set is hidden from every read in lib/repo.ts unless the
  // caller passes includeDeleted — the filter lives there, not here, so it is
  // spelled out at each query rather than implied. Registrations, awards and
  // files are all KEPT while trashed; restoring is clearing these four
  // columns. permanentDeleteAt is deletedAt + Config.TRASH_RETENTION_DAYS,
  // recomputed for everything in the bin when that setting changes.
  deletedAt         DateTime?
  deletedById       String?
  deleteReason      String?
  permanentDeleteAt DateTime?

  registrations      Registration[]
  createdEvents      Event[]        @relation("EventCreatedBy")
  openedEvents       Event[]        @relation("EventOpenedBy")
  adminLogs          AdminLog[]
  uploadedFiles      UploadedFile[]
  createdJoinCodes   JoinCode[]     @relation("JoinCodeCreatedBy")
  finalizedGroups    EventGroup[]   @relation("EventGroupFinalizedBy")
  pointAwards        PointAward[]   @relation("PointAwardUser")
  awardedPointAwards PointAward[]   @relation("PointAwardAwardedBy")
  revokedPointAwards PointAward[]   @relation("PointAwardRevokedBy")

  awardedHousePoints HousePointAward[] @relation("HousePointAwardAwardedBy")
  revokedHousePoints HousePointAward[] @relation("HousePointAwardRevokedBy")

  permissionGrants        PermissionGrant[] @relation("PermissionGrantUser")
  grantedPermissionGrants PermissionGrant[] @relation("PermissionGrantGrantedBy")
  revokedPermissionGrants PermissionGrant[] @relation("PermissionGrantRevokedBy")

  @@unique([orgId, email])
  @@index([orgId])
  @@index([role])
  @@index([status])
  @@index([duesVerifiedAt])
  @@index([nationalVerifiedAt])
  @@index([orgId, permanentDeleteAt])
}

// Never publicly addressable — always served through GET /api/files/[id],
// which checks owner-or-EBOARD. storageKey is a driver-internal handle
// (local disk path or Blob pathname), never a public URL. See lib/storage.ts.
model UploadedFile {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  kind         FileKind
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([userId, kind])
}

// Replaces the old flat PointSystem (eventType -> points) map. A category
// carries everything about "what kind of activity is this" that used to be
// hardcoded: the tier/point value, whether it feeds the Monthly Engagement
// Champion calculation, and whether it contributes to the internal E-Board
// track (replacing the old per-event Event.countsForEboard flag — see
// lib/points.ts eboardAwardFor). Editable at /admin/settings/categories with
// no deploy required — nothing in lib/points.ts hardcodes a point value.
model EventCategory {
  id               String   @id @default(cuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id])
  code             String
  name             String
  shortName        String
  // null for non-tiered categories (NSBE Week, E-Board meeting/retreat).
  tier             Int?
  memberPoints     Int
  examples         String?
  countsForMonthly Boolean  @default(true)
  eboardEligible   Boolean  @default(true)
  audience         Audience @default(ALL)
  active           Boolean  @default(true)
  sortOrder        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events Event[]

  @@unique([orgId, code])
  @@index([orgId])
}

// An NSBE-Week-shaped set of events whose completion bonus is only knowable
// once the last event in the set closes (see lib/points.ts groupBonusFor —
// evaluated at read time, nothing here is a stored point value).
// bonusTiers is data, not code: [{min,max,bonus}, ...] — an admin edits the
// tiers directly if the week runs long or short a year.
model EventGroup {
  id                 String    @id @default(cuid())
  orgId              String
  org                Org       @relation(fields: [orgId], references: [id])
  name               String
  slug               String
  kind               GroupKind
  expectedEventCount Int       @default(5)
  bonusTiers         Json
  // Manual override for when a planned event in the set is canceled — the
  // group settles its bonus against whatever events actually exist rather
  // than waiting forever for an event that will never happen.
  finalizedAt        DateTime?
  finalizedById      String?
  finalizedBy        User?     @relation("EventGroupFinalizedBy", fields: [finalizedById], references: [id])
  createdAt          DateTime  @default(now())

  events Event[]

  @@unique([orgId, slug])
  @@index([orgId])
}

// Bonuses not tied to a check-in. GAME_COMPETITION and MONTHLY_CHAMPION are
// capped/deduplicated by their respective @@unique constraint below (Postgres
// treats NULL as distinct, so each constraint only actually bites on the kind
// it's named for) — never by application logic alone. MANUAL awards carry
// neither eventId nor periodMonth and aren't count-limited.
//
// ADJUSTMENT rows are signed corrections: points may be negative, reason is at
// least 10 characters, and season is stamped from Config.SEASON at creation so
// a rollover drops them (see lib/points.ts awardCountsForSeason). Their
// optional event link is relatedEventId, NOT eventId — eventId is part of the
// GAME_COMPETITION cap below, so two adjustments tied to the same event would
// collide on it. Both rules are also CHECK constraints (migration
// 20260918120000_point_adjustments_and_trash).
model PointAward {
  id             String    @id @default(cuid())
  orgId          String
  org            Org       @relation(fields: [orgId], references: [id])
  userId         String
  user           User      @relation("PointAwardUser", fields: [userId], references: [id])
  kind           AwardKind
  points         Int
  // Required for GAME_COMPETITION — the @@unique below is the actual +1-per-member-per-event cap.
  eventId        String?
  event          Event?    @relation(fields: [eventId], references: [id])
  // "2026-09" — required for MONTHLY_CHAMPION.
  periodMonth    String?
  reason         String
  awardedById    String?
  awardedBy      User?     @relation("PointAwardAwardedBy", fields: [awardedById], references: [id])
  awardedAt      DateTime  @default(now())
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?     @relation("PointAwardRevokedBy", fields: [revokedById], references: [id])
  revokeNote     String?
  // ADJUSTMENT only — see the model comment above.
  season         String?
  relatedEventId String?
  relatedEvent   Event?    @relation("PointAwardRelatedEvent", fields: [relatedEventId], references: [id], onDelete: SetNull)

  @@unique([orgId, userId, kind, eventId])
  @@unique([orgId, userId, kind, periodMonth])
  @@index([orgId, userId])
  @@index([orgId, kind, season])
}

model Event {
  id              String        @id @default(cuid())
  orgId           String
  org             Org           @relation(fields: [orgId], references: [id])
  slug            String
  name            String
  categoryId      String
  category        EventCategory @relation(fields: [categoryId], references: [id])
  // Assigns this event to an NSBE-Week-style set — see EventGroup above.
  groupId         String?
  group           EventGroup?   @relation(fields: [groupId], references: [id])
  date            DateTime
  location        String?
  description     String?
  pointsOverride  Int?
  status          EventStatus   @default(DRAFT)
  opensAt         DateTime?
  closesAt        DateTime?
  // App-layer default is Config.DEFAULT_EVENT_DURATION (see lib/repo.ts
  // createEvent/updateEvent) — this column default is only a DB-level
  // fallback for a row inserted outside the app layer.
  durationMinutes Int           @default(15)
  openedById      String?
  openedBy        User?         @relation("EventOpenedBy", fields: [openedById], references: [id])
  openedAt        DateTime?
  reopenNote      String?
  // EBOARD_ONLY events never appear in the member feed, 403 for a GENERAL user
  // on direct URL, and are excluded from the member leaderboard (see
  // src/lib/points.ts eboardAwardFor / computeEboardStandings).
  audience        Audience      @default(ALL)
  createdById     String?
  createdBy       User?         @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // The trash bin — same four columns and same rules as User's. A trashed
  // event's Registrations are kept, but count toward NOTHING until it is
  // restored: every registration count in lib/repo.ts joins to Event and
  // filters deletedAt, not only the registrant's.
  deletedAt         DateTime?
  deletedById       String?
  deleteReason      String?
  permanentDeleteAt DateTime?

  // House scoring (see HousePointAward and lib/house-scoring.ts). The four
  // flags are independent — any combination may be set.
  countsForShowUp        Boolean   @default(false)
  countsForRepYourHouse  Boolean   @default(false)
  countsForMonthlyHouse  Boolean   @default(false)
  isHouseCompetition     Boolean   @default(false)
  // When House scoring last ran for this event. Null = never. An event whose
  // closesAt is later than this (it was reopened) is due again.
  houseScoredAt          DateTime?
  // Set when attendance or a House flag changes after the event was scored —
  // the event's own awards are then recomputed (inline, and by the lazy sweep
  // as a backstop) and this clears. Restoring from the trash never sets it:
  // the rows were kept, so they come back exactly as they were.
  houseScoringStale      Boolean   @default(false)
  // Bumped whenever something that feeds this event's MONTH numbers changes
  // after close — attendance added/removed, restored from the trash, a House
  // flag edited. A calculated Own the Month older than this is flagged as
  // needing recalculation; it is never recalculated automatically.
  houseChangedAt         DateTime?
  // isHouseCompetition only — chosen by an admin after the event closes.
  competitionWinners     House[]   @default([])
  competitionWinnersById String?

  fields             FormField[]
  registrations      Registration[]
  pointAwards        PointAward[]
  relatedAdjustments PointAward[]      @relation("PointAwardRelatedEvent")
  housePointAwards   HousePointAward[]

  @@unique([orgId, slug])
  @@index([orgId, permanentDeleteAt])
  @@index([orgId])
  @@index([status, opensAt, closesAt])
  @@index([categoryId])
  @@index([groupId])
}

// One House's points for one reason. House totals are DERIVED by summing the
// non-revoked rows for a season whose event (if any) is live — nothing stores
// a running total. See lib/house-repo.ts.
//
// Idempotency is the two @@unique constraints, not application logic: there
// is exactly one row per (House, category, event) and per (House, category,
// month), revoked or not, so reprocessing an event can only UPDATE its rows.
// Postgres treats NULL as distinct, so MANUAL rows (neither eventId nor
// periodMonth) are unlimited, and each constraint only bites on the
// categories that carry its column — enforced by CHECKs in the migration.
//
// Every automatic row records its inputs: attendeeCount / rosterCount /
// percentage and the attending member ids, as of the moment scoring ran.
// A recalculation overwrites them with the CURRENT roster's numbers and moves
// the first values into originalSnapshot, once, so an admin can always see
// what the award originally said. A 0-point row is still written for a House
// that was scored and earned nothing — it is the record of WHY.
model HousePointAward {
  id               String        @id @default(cuid())
  orgId            String
  org              Org           @relation(fields: [orgId], references: [id])
  // Event awards: the season of the event's date. Month awards: the month's.
  // MANUAL: Config.SEASON at creation. The House board shows Config.SEASON only.
  season           String
  house            House
  category         HouseCategory
  points           Int
  eventId          String?
  event            Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "2026-10" — OWN_THE_MONTH only.
  periodMonth      String?
  attendeeCount    Int?
  rosterCount      Int?
  // attendeeCount / rosterCount x 100 (or the monthly average), to 4 places.
  // Display and audit only — comparisons use exact fractions.
  percentage       Decimal?      @db.Decimal(7, 4)
  attendeeIds      String[]      @default([])
  // Every input the rule compared — e.g. all four Houses' percentages for
  // REP_YOUR_HOUSE, each event's percentage for OWN_THE_MONTH.
  inputs           Json?
  // The values this row was first written with, kept once a recalculation
  // changes them. Null until then.
  originalSnapshot Json?
  recalculatedAt   DateTime?
  reason           String
  // Null when automatic.
  awardedById      String?
  awardedBy        User?         @relation("HousePointAwardAwardedBy", fields: [awardedById], references: [id])
  awardedAt        DateTime      @default(now())
  revokedAt        DateTime?
  revokedById      String?
  revokedBy        User?         @relation("HousePointAwardRevokedBy", fields: [revokedById], references: [id])
  revokeNote       String?

  @@unique([orgId, house, category, eventId])
  @@unique([orgId, house, category, periodMonth])
  @@index([orgId, season, house])
  @@index([eventId])
}

model FormField {
  id       String    @id @default(cuid())
  eventId  String
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldKey String
  label    String
  type     FieldType
  required Boolean   @default(false)
  options  String[]
  helpText String?
  order    Int
  prefill  String?

  @@unique([eventId, fieldKey])
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id])
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  pointsAwarded Int
  roleAtTime    Role
  source        RegistrationSource @default(FORM)
  note          String?
  createdAt     DateTime           @default(now())

  // Audit snapshot of the core-form answers at submit time — the User row
  // stays the live source of truth (see lib/core-form.ts); these columns
  // just make old rows interpretable. pointsAwarded is NEVER zeroed for
  // ineligibility — see lib/points.ts isEligible and computeStandings.
  classificationAtTime   Classification?
  majorAtTime            String?
  duesReportedAtTime     Boolean?
  nationalReportedAtTime Boolean?
  coreFormVersion        Int?
  eligibleAtTime         Boolean?

  answers Answer[]

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

// Normalized (fieldKey/value rows) rather than a JSON column so the
// responses grid and CSV export are plain queries and this stays portable.
// Multi-select values join with " | ".
model Answer {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fieldKey       String
  value          String

  @@unique([registrationId, fieldKey])
}

model Config {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id])
  key   String
  value String

  @@unique([orgId, key])
  @@index([orgId])
}

// One row per (orgId, userId, permission) — granting after a revoke reuses
// the same row (revokedAt/revokedById reset to null) rather than inserting a
// second one, so the grant/revoke history for that capability stays on a
// single, queryable row. userId cascades: a deleted user's grants are
// meaningless and should vanish with them (see scripts/clear-seed-data.ts,
// which never has to know this table exists).
model PermissionGrant {
  id         String     @id @default(cuid())
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id])
  userId     String
  user       User       @relation("PermissionGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  grantedAt   DateTime @default(now())
  grantedById String?
  grantedBy   User?    @relation("PermissionGrantGrantedBy", fields: [grantedById], references: [id])

  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("PermissionGrantRevokedBy", fields: [revokedById], references: [id])

  @@unique([orgId, userId, permission])
  @@index([orgId, permission])
}

// One-shot claim ticket for an action that must not run twice.
//
// The client sends a requestToken with every confirm-dialog submission (see
// components/ui/ConfirmDialog.tsx, which mints one per opening). An action that
// generates a credential — resetPassword, rotateJoinCodeById — inserts that
// token in the SAME transaction as its work, so the unique index below is what
// actually makes a double-submit impossible: the second transaction blocks on
// the index, then fails, and its work rolls back with it. A disabled button is
// a UX affordance; this is the guarantee.
//
// Rows are keepable history (they say a reset was requested and collapsed) but
// nothing reads them back, so they are safe to prune by createdAt if the table
// ever grows — the volume is one row per admin credential operation.
model RequestClaim {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  /**
   * The action being guarded, e.g. "reset_password".
   */
  scope     String
  /**
   * Client-generated, unique per confirm-dialog opening.
   */
  token     String
  /**
   * What the action acted on, for reading the table later. Never part of the key.
   */
  target    String?
  createdAt DateTime @default(now())

  @@unique([orgId, scope, token])
  @@index([createdAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([createdAt])
}
